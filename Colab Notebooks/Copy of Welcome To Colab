{"cells":[{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","import matplotlib.patches as patches\n","\n","# Create the figure and axis\n","fig, ax = plt.subplots(figsize=(10, 7))\n","\n","# Set the limits and hide the axes for a clean diagram look\n","ax.set_xlim(0, 10)\n","ax.set_ylim(0, 9)\n","ax.axis('off')\n","\n","# Define a color palette\n","roof_base_color = '#1b3a4b'\n","pillar_colors = ['#14505c', '#207567', '#589a71', '#9bc087']\n","text_color_light = 'white'\n","text_color_dark = 'black'\n","\n","# 1. Draw the \"Roof\" (Smart Bangladesh Vision 2041)\n","roof = patches.Rectangle((0.5, 6.5), 9.0, 1.5, facecolor=roof_base_color, edgecolor='none')\n","ax.add_patch(roof)\n","ax.text(5, 7.25, 'Smart Bangladesh Vision 2041', fontsize=18, fontweight='bold',\n","        color=text_color_light, ha='center', va='center')\n","\n","# 2. Draw the Four Pillars\n","pillars_data = [\n","    (\"Smart\\nCitizen\", \"Digital\\nupskilling\"),\n","    (\"Smart\\nGovernment\", \"Transparent\\nsafety nets\"),\n","    (\"Smart\\nSociety\", \"Inclusive digital\\necosystem\"),\n","    (\"Smart\\nEconomy\", \"Circular economy &\\ndecentralized\\nemployment\")\n","]\n","\n","# X-coordinates for the start of each pillar\n","x_positions = [1.25, 3.25, 5.25, 7.25]\n","\n","for i in range(4):\n","    # Create the pillar rectangle\n","    pillar = patches.Rectangle((x_positions[i], 2), 1.5, 4.5, facecolor=pillar_colors[i], edgecolor='none')\n","    ax.add_patch(pillar)\n","\n","    # Add Pillar Title\n","    ax.text(x_positions[i] + 0.75, 5.5, pillars_data[i][0], fontsize=12, fontweight='bold',\n","            color=text_color_light, ha='center', va='center')\n","\n","    # Add Pillar Subtitle/Description\n","    ax.text(x_positions[i] + 0.75, 3.5, pillars_data[i][1], fontsize=10,\n","            color=text_color_light, ha='center', va='center')\n","\n","# 3. Draw the \"Base\" (Foundation)\n","base = patches.Rectangle((0.5, 1.0), 9.0, 1.0, facecolor=roof_base_color, edgecolor='none')\n","ax.add_patch(base)\n","ax.text(5, 1.5, 'Poverty Alleviation & Technological Inclusivity', fontsize=14, fontweight='bold',\n","        color=text_color_light, ha='center', va='center')\n","\n","# 4. Add the APA Citation at the bottom\n","citation = (\"Figure 1. The Four Pillars of the Smart Bangladesh Framework.\\n\"\n","            \"Adapted from Smart Bangladesh Vision 2041, by a2i, 2022, \"\n","            \"Access to Information Programme, Government of Bangladesh.\")\n","ax.text(5, 0.2, citation, fontsize=9, style='italic', color=text_color_dark, ha='center', va='center')\n","\n","# Adjust layout and display/save\n","plt.tight_layout()\n","\n","# Uncomment the line below if you want to save the image directly to your computer\n","# plt.savefig('Smart_Bangladesh_Pillars.png', dpi=300, bbox_inches='tight')\n","\n","plt.show()"],"metadata":{"id":"hDMrnt-buYHs","colab":{"base_uri":"https://localhost:8080/","height":391},"executionInfo":{"status":"ok","timestamp":1775293336729,"user_tz":420,"elapsed":182,"user":{"displayName":"MD FARHAD HOSSEN","userId":"13807511848021610528"}},"outputId":"4b6e2753-6f98-46b9-eabb-5bfc4da45ca5"},"execution_count":2,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x700 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","import numpy as np\n","\n","# Data\n","categories = ['Time Required', 'Cost of Service']\n","before_udc = [100, 100]  # Baseline at 100%\n","after_udc = [15, 37]     # Reduced percentages\n","\n","# X-axis positioning\n","x = np.arange(len(categories))\n","width = 0.35  # Width of the bars\n","\n","# Create figure and axis\n","fig, ax = plt.subplots(figsize=(8, 6))\n","\n","# Plot bars\n","rects1 = ax.bar(x - width/2, before_udc, width, label='Before UDC (Baseline)', color='#9ca3af') # Gray\n","rects2 = ax.bar(x + width/2, after_udc, width, label='After UDC', color='#2563eb') # Distinct Blue\n","\n","# Add labels, title, and custom x-axis tick labels\n","ax.set_ylabel('Percentage (%)', fontsize=12)\n","ax.set_title('Impact of UDCs on Rural Service Delivery (TCV Model)', fontsize=14, fontweight='bold', pad=15)\n","ax.set_xticks(x)\n","ax.set_xticklabels(categories, fontsize=12)\n","ax.set_ylim(0, 115) # Leave room for labels on top of bars\n","\n","# Add a legend\n","ax.legend(loc='upper right', fontsize=11)\n","\n","# Function to add percentage labels on top of the bars\n","def autolabel(rects):\n","    for rect in rects:\n","        height = rect.get_height()\n","        ax.annotate(f'{height}%',\n","                    xy=(rect.get_x() + rect.get_width() / 2, height),\n","                    xytext=(0, 3),  # 3 points vertical offset\n","                    textcoords=\"offset points\",\n","                    ha='center', va='bottom', fontsize=11, fontweight='bold')\n","\n","autolabel(rects1)\n","autolabel(rects2)\n","\n","# Hide the top and right spines for a cleaner look\n","ax.spines['top'].set_visible(False)\n","ax.spines['right'].set_visible(False)\n","\n","# Add the APA Citation at the bottom\n","citation = (\"Figure 2. Reduction in Time, Cost, and Visits (TCV) due to Union Digital Centers.\\n\"\n","            \"Data sourced from Mamun, M. A. A., & Begum, M. (2018).\")\n","plt.figtext(0.5, -0.02, citation, ha='center', fontsize=10, style='italic', color='black')\n","\n","# Adjust layout to prevent clipping of the citation\n","plt.tight_layout()\n","\n","# Uncomment the line below to save the image directly to your computer\n","# plt.savefig('UDC_Impact_TCV_Model.png', dpi=300, bbox_inches='tight')\n","\n","# Display the graph\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":439},"id":"oeX8xOZvugco","executionInfo":{"status":"ok","timestamp":1775293336883,"user_tz":420,"elapsed":152,"user":{"displayName":"MD FARHAD HOSSEN","userId":"13807511848021610528"}},"outputId":"a9e31d78-9fb5-4d4a-f8af-e55fd7c69c33"},"execution_count":3,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","import matplotlib.patches as patches\n","from matplotlib.patches import FancyBboxPatch\n","\n","# Create the figure and axis\n","fig, ax = plt.subplots(figsize=(12, 8))\n","\n","# Set the limits and hide the axes for a clean diagram look\n","ax.set_xlim(0, 12)\n","ax.set_ylim(0, 10)\n","ax.axis('off')\n","\n","# Define a professional academic color palette\n","box_color_1 = '#e0f2fe' # Light Blue (Independent)\n","box_color_2 = '#fef08a' # Light Yellow (Moderating)\n","box_color_3 = '#dcfce7' # Light Green (Dependent)\n","edge_color = '#0f172a'  # Dark Slate\n","\n","# Function to create formatted text inside boxes\n","def add_box_text(x, y, title, subtitle, bullets):\n","    ax.text(x, y + 1.2, title, fontsize=12, fontweight='bold', ha='center', va='center', color='black')\n","    ax.text(x, y + 0.7, subtitle, fontsize=11, style='italic', ha='center', va='center', color='#334155')\n","    ax.text(x - 1.3, y - 0.5, bullets, fontsize=11, ha='left', va='center', color='black', linespacing=1.8)\n","\n","# --- 1. Draw Box 1: Independent Variables (Left) ---\n","# Coordinates: x=0.5, y=1.5, width=3.5, height=4\n","box1 = FancyBboxPatch((0.5, 1.5), 3.5, 4, boxstyle=\"round,pad=0.1\",\n","                      facecolor=box_color_1, edgecolor=edge_color, linewidth=1.5)\n","ax.add_patch(box1)\n","add_box_text(2.25, 3.5, \"Independent Variables\", \"(Information Sector Interventions)\",\n","             \"• E-Governance (UDCs)\\n• Digital Finance (MFS)\\n• E-Agriculture Platforms\")\n","\n","# --- 2. Draw Box 3: Dependent Variable (Right) ---\n","# Coordinates: x=8, y=1.5, width=3.5, height=4\n","box3 = FancyBboxPatch((8.0, 1.5), 3.5, 4, boxstyle=\"round,pad=0.1\",\n","                      facecolor=box_color_3, edgecolor=edge_color, linewidth=1.5)\n","ax.add_patch(box3)\n","add_box_text(9.75, 3.5, \"Dependent Variable\", \"(Multidimensional Poverty Reduction)\",\n","             \"• Economic Impact & Stability\\n• Social Impact / Empowerment\\n• Capability Expansion\")\n","\n","# --- 3. Draw Box 2: Moderating Variables (Top Middle) ---\n","# Coordinates: x=4.25, y=6.5, width=3.5, height=3\n","box2 = FancyBboxPatch((4.25, 6.5), 3.5, 3, boxstyle=\"round,pad=0.1\",\n","                      facecolor=box_color_2, edgecolor=edge_color, linewidth=1.5)\n","ax.add_patch(box2)\n","add_box_text(6.0, 7.5, \"Moderating Variables\", \"(The Chuadanga Context)\",\n","             \"• Digital Literacy Levels\\n• Infrastructural Constraints\\n• Socio-Cultural Dynamics\")\n","\n","# --- 4. Draw the Arrows ---\n","# Main Arrow: From Box 1 to Box 3\n","main_arrow = patches.FancyArrowPatch((4.1, 3.5), (7.9, 3.5),\n","                                     mutation_scale=25, lw=2.5, color=edge_color, arrowstyle=\"-|>\")\n","ax.add_patch(main_arrow)\n","\n","# Moderating Arrow: From Box 2 pointing down to the middle of the Main Arrow\n","mod_arrow = patches.FancyArrowPatch((6.0, 6.4), (6.0, 3.6),\n","                                    mutation_scale=25, lw=2.5, color=edge_color, arrowstyle=\"-|>\")\n","ax.add_patch(mod_arrow)\n","\n","# Add a label for the moderating effect next to the vertical arrow\n","ax.text(6.2, 5.0, 'Moderates\\nthe impact', fontsize=10, style='italic', color='#475569', va='center')\n","\n","# --- 5. Add the APA Citation at the bottom ---\n","citation = (\"Figure 3. Conceptual framework illustrating the impact of the localized information sector\\n\"\n","            \"on multidimensional poverty reduction. Source: Author's elaboration.\")\n","ax.text(6.0, -0.2, citation, fontsize=10, style='italic', color='black', ha='center', va='center')\n","\n","# Adjust layout and show/save\n","plt.tight_layout()\n","\n","# Uncomment the line below to save the image directly to your computer\n","# plt.savefig('Conceptual_Framework.png', dpi=300, bbox_inches='tight')\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":375},"id":"7NquEPyyuglX","executionInfo":{"status":"ok","timestamp":1775293337103,"user_tz":420,"elapsed":218,"user":{"displayName":"MD FARHAD HOSSEN","userId":"13807511848021610528"}},"outputId":"e2c96acd-4f69-4f99-fc22-d4f78fd48b59"},"execution_count":4,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","import matplotlib.patches as patches\n","import numpy as np\n","\n","# Set global formatting for academic look\n","plt.style.use('seaborn-v0_8-whitegrid')\n","\n","# ==========================================\n","# FIGURE 1: Mixed-Methods Design Flowchart\n","# ==========================================\n","def create_flowchart():\n","    fig, ax = plt.subplots(figsize=(10, 4))\n","    ax.axis('off')\n","\n","    # Define box properties\n","    box_style = dict(boxstyle=\"round,pad=0.5\", edgecolor=\"black\", facecolor=\"#E8F0FE\")\n","    text_props = dict(ha=\"center\", va=\"center\", fontsize=11, fontweight='bold', bbox=box_style)\n","\n","    # Coordinates and labels for the flowchart\n","    boxes = [\n","        (0.15, 0.5, \"Phase 1: Quantitative\\n(Household Surveys)\\nn=422\"),\n","        (0.50, 0.5, \"Data Analysis\\n(SPSS: Logistic Regression)\"),\n","        (0.85, 0.5, \"Phase 2: Qualitative\\n(FGDs & KIIs)\\nExplaining Trends\")\n","    ]\n","\n","    # Draw boxes\n","    for x, y, text in boxes:\n","        ax.text(x, y, text, **text_props)\n","\n","    # Draw arrows\n","    arrow_props = dict(facecolor='black', width=2, headwidth=10, shrink=0.1)\n","    ax.annotate('', xy=(0.35, 0.5), xytext=(0.28, 0.5), arrowprops=arrow_props)\n","    ax.annotate('', xy=(0.70, 0.5), xytext=(0.63, 0.5), arrowprops=arrow_props)\n","\n","    plt.title(\"Explanatory Sequential Mixed-Methods Design\", fontsize=14, fontweight='bold', pad=20)\n","    plt.tight_layout()\n","    plt.savefig(\"research_design_flowchart.png\", dpi=300, bbox_inches='tight')\n","    plt.show()\n","\n","# ==========================================\n","# FIGURE 2: Stratified Sample Distribution\n","# ==========================================\n","def create_sample_chart():\n","    # Note: These are estimated proportional distributions based on general\n","    # population density logic. Adjust the 'population_percentages' to match your actual data.\n","    upazilas = ['Alamdanga', 'Chuadanga Sadar', 'Damurhuda', 'Jibannagar']\n","    population_percentages = [0.30, 0.35, 0.20, 0.15]\n","    total_sample = 422\n","\n","    # Calculate target samples per Upazila\n","    samples = [int(round(p * total_sample)) for p in population_percentages]\n","\n","    fig, ax = plt.subplots(figsize=(8, 5))\n","\n","    # Create bar chart\n","    bars = ax.bar(upazilas, samples, color=['#4C72B0', '#55A868', '#C44E52', '#8172B3'], edgecolor='black')\n","\n","    # Add data labels on top of the bars\n","    for bar in bars:\n","        height = bar.get_height()\n","        ax.annotate(f'n={height}',\n","                    xy=(bar.get_x() + bar.get_width() / 2, height),\n","                    xytext=(0, 3),  # 3 points vertical offset\n","                    textcoords=\"offset points\",\n","                    ha='center', va='bottom', fontweight='bold')\n","\n","    # Formatting\n","    ax.set_ylabel('Number of Households Surveyed', fontsize=12, fontweight='bold')\n","    ax.set_xlabel('Upazilas (Strata)', fontsize=12, fontweight='bold')\n","    ax.set_title('Proportional Stratified Sample Distribution (Total n=422)', fontsize=14, fontweight='bold', pad=15)\n","    ax.set_ylim(0, max(samples) + 30) # Add headroom for labels\n","\n","    plt.tight_layout()\n","    plt.savefig(\"sample_distribution.png\", dpi=300, bbox_inches='tight')\n","    plt.show()\n","\n","# Execute functions to generate images\n","create_flowchart()\n","create_sample_chart()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":761},"id":"0NwxG7vb0xe9","executionInfo":{"status":"ok","timestamp":1775294952108,"user_tz":420,"elapsed":1469,"user":{"displayName":"MD FARHAD HOSSEN","userId":"13807511848021610528"}},"outputId":"f7402bad-accd-48f2-ee49-5d26602e4157"},"execution_count":5,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","import numpy as np\n","\n","# Data\n","crops = ['Boro Paddy', 'Maize', 'Tobacco', 'Summer Onions']\n","traditional_margin = [15, 20, 30, 25] # Representative percentage\n","digital_margin = [25, 35, 45, 40]     # Representative percentage\n","\n","x = np.arange(len(crops))\n","width = 0.35\n","\n","# Plotting\n","fig, ax = plt.subplots(figsize=(8, 6))\n","rects1 = ax.bar(x - width/2, traditional_margin, width, label='Traditional Supply Chain (Intermediaries)', color='#d9534f')\n","rects2 = ax.bar(x + width/2, digital_margin, width, label='Digital Direct Market (E-Agriculture)', color='#5cb85c')\n","\n","# Formatting\n","ax.set_ylabel('Profit Margin (%)', fontsize=12)\n","ax.set_title('Impact of Digital Platforms on Crop Profit Margins in Chuadanga', fontsize=14)\n","ax.set_xticks(x)\n","ax.set_xticklabels(crops, fontsize=11)\n","ax.legend()\n","\n","# Add value labels\n","ax.bar_label(rects1, padding=3)\n","ax.bar_label(rects2, padding=3)\n","\n","fig.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":419},"id":"7MCnl9-H179S","executionInfo":{"status":"ok","timestamp":1775299563570,"user_tz":420,"elapsed":311,"user":{"displayName":"MD FARHAD HOSSEN","userId":"13807511848021610528"}},"outputId":"0a2917f4-101a-4b41-8d1c-16eb952a237e"},"execution_count":6,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","\n","# Data\n","metrics = ['Time Spent (Hours)', 'Financial Cost (BDT)', 'Number of Visits']\n","traditional_tcv = [8, 500, 3] # e.g., 8 hours travel/wait, 500 BDT travel/bribe, 3 visits\n","udc_tcv = [1, 100, 1]         # e.g., 1 hour wait, 100 BDT official fee, 1 visit\n","\n","# Calculate percentage reduction for a clean visualization\n","reductions = [\n","    ((traditional_tcv[0] - udc_tcv[0]) / traditional_tcv[0]) * 100,\n","    ((traditional_tcv[1] - udc_tcv[1]) / traditional_tcv[1]) * 100,\n","    ((traditional_tcv[2] - udc_tcv[2]) / traditional_tcv[2]) * 100\n","]\n","\n","# Plotting\n","fig, ax = plt.subplots(figsize=(8, 5))\n","bars = ax.bar(metrics, reductions, color='#0275d8', width=0.5)\n","\n","# Formatting\n","ax.set_ylabel('Percentage Reduction (%)', fontsize=12)\n","ax.set_title('TCV Reduction via Decentralized UDC Services', fontsize=14)\n","ax.set_ylim(0, 100)\n","\n","# Add value labels\n","for bar in bars:\n","    yval = bar.get_height()\n","    ax.text(bar.get_x() + bar.get_width()/2, yval + 2, f'{int(yval)}%', ha='center', va='bottom', fontweight='bold')\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":351},"id":"clHqhmg2G_-8","executionInfo":{"status":"ok","timestamp":1775299726976,"user_tz":420,"elapsed":219,"user":{"displayName":"MD FARHAD HOSSEN","userId":"13807511848021610528"}},"outputId":"22ee4bc4-8c2d-47f9-ec40-96fb91c4ef30"},"execution_count":7,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","\n","# Data\n","labels = ['Inbound Remittance (Domestic/Intl)', 'Micro-savings (Digital DPS)', 'Agricultural Inputs', 'Healthcare